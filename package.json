{
  "name": "bit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "bun --filter @repo/db db:generate:migrations",
    "db:migrate": "bun --filter @repo/db db:migrate",
    "seed:run": "bun --filter @repo/seeder seed:run",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "mcp:client": "bunx @modelcontextprotocol/inspector --server-url http://localhost:3000/api/v1/mcp --transport http --header 'x-api-key: $BIT_API_KEY'"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "turbo": "^2.10.9"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
