# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=dev

# ---------------------------------------------------------------------------
# Database (Postgres + pgvector)
# ---------------------------------------------------------------------------
DB_NAME=bit_dev
DB_USER=bit
DB_PASS=bit
DB_HOST=postgres
DB_PORT=5432
# The app + drizzle-kit read DATABASE_URL directly. For local (host) runs use
# localhost; inside compose the services reach Postgres at host `postgres`.
DATABASE_URL=postgres://bit:bit@localhost:5432/bit_dev

# ---------------------------------------------------------------------------
# Embeddings (bge-m3, dense 1024) + reranker (bge-reranker-v2-m3)
# Local only — queries carry sensitive context and MUST NOT leave the machine.
# Endpoints are HuggingFace text-embeddings-inference (TEI) servers.
# Inside compose: http://embeddings:80 / http://reranker:80
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_ENDPOINT=http://localhost:8085
RERANK_MODEL=bge-reranker-v2-m3
RERANK_ENDPOINT=http://localhost:8086

# ---------------------------------------------------------------------------
# Transport — MCP is served over Streamable HTTP (on Hono); there is no stdio.
# ---------------------------------------------------------------------------
HTTP_PORT=3000

# ---------------------------------------------------------------------------
# Auth (better-auth)
# ---------------------------------------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed to initiate auth flows (the web UIs).
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Discord OAuth. Discord is the SOLE sign-in method in production; email +
# password sign-in is enabled only in dev/staging (ENVIRONMENT != production).
# Create an app at https://discord.com/developers/applications and add the
# redirect `${BETTER_AUTH_URL}/api/auth/callback/discord`.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Migration / seed retry knobs (used by scripts/run-*.sh)
# ---------------------------------------------------------------------------
MIGRATION_MAX_ATTEMPTS=20
MIGRATION_RETRY_DELAY_SECONDS=3
SEED_MAX_ATTEMPTS=20
SEED_RETRY_DELAY_SECONDS=3
