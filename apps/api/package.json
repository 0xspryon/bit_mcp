{
  "name": "api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hc": {
      "types": "./dist/hc.d.ts",
      "default": "./dist/hc.js"
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "bun run src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval:recall": "bun run src/eval/recall-at-k.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.15",
    "@repo/db": "*",
    "@repo/env": "*",
    "@repo/rag-core": "*",
    "better-auth": "^1.6.15",
    "effect": "^3.21.2",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@testcontainers/postgresql": "^11.0.0",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "pg": "^8.21.0",
    "testcontainers": "^11.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
